{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "photoURL": { "type": "string" },
        "status": { "type": "string", "enum": ["online", "idle", "dnd", "offline"] },
        "lastSeen": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "email"]
    },
    "Server": {
      "title": "Server",
      "description": "A server containing multiple channels",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "ownerId": { "type": "string" },
        "iconURL": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "ownerId"]
    },
    "Channel": {
      "title": "Channel",
      "description": "A chat or voice channel within a server",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "serverId": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string", "enum": ["text", "voice"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "serverId", "name", "type"]
    },
    "Message": {
      "title": "Message",
      "description": "A chat message",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "channelId": { "type": "string" },
        "serverId": { "type": "string" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "authorPhoto": { "type": "string" },
        "content": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "isAI": { "type": "boolean" }
      },
      "required": ["id", "channelId", "authorId", "content", "timestamp"]
    },
    "FriendRequest": {
      "title": "FriendRequest",
      "description": "A request to be friends",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "fromId": { "type": "string" },
        "fromName": { "type": "string" },
        "fromPhoto": { "type": "string" },
        "toId": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "accepted", "declined"] },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "fromId", "toId", "status"]
    },
    "Friendship": {
      "title": "Friendship",
      "description": "A confirmed friendship",
      "type": "object",
      "properties": {
        "friendId": { "type": "string" },
        "friendName": { "type": "string" },
        "friendPhoto": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["friendId", "friendName"]
    },
    "ServerMember": {
      "title": "ServerMember",
      "description": "A member of a server",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "role": { "type": "string", "enum": ["owner", "admin", "member"] },
        "joinedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "role"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/users/{userId}/friendRequests/{requestId}": {
      "schema": "FriendRequest",
      "description": "Incoming and outgoing friend requests"
    },
    "/users/{userId}/friends/{friendId}": {
      "schema": "Friendship",
      "description": "User's friends list"
    },
    "/servers/{serverId}": {
      "schema": "Server",
      "description": "Servers"
    },
    "/servers/{serverId}/members/{userId}": {
      "schema": "ServerMember",
      "description": "Members of a server"
    },
    "/servers/{serverId}/channels/{channelId}": {
      "schema": "Channel",
      "description": "Channels within a server"
    },
    "/servers/{serverId}/channels/{channelId}/messages/{messageId}": {
      "schema": "Message",
      "description": "Messages within a channel"
    }
  }
}
