rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    // Collection: users
    // Fields: uid, displayName, email, photoURL, status, lastSeen
    //
    // Collection: servers
    // Fields: id, name, ownerId, iconURL, createdAt
    //
    // Collection: channels
    // Fields: id, serverId, name, type, createdAt
    //
    // Collection: messages
    // Fields: id, channelId, serverId, authorId, authorName, authorPhoto, content, timestamp, isAI
    // ===============================================================

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'displayName', 'email']) &&
             data.uid is string && data.displayName is string &&
             data.email is string && data.email.size() < 256;
    }

    function isValidServer(data) {
      return data.keys().hasAll(['id', 'name', 'ownerId']) &&
             data.name is string && data.name.size() > 0 && data.name.size() < 100;
    }

    function isValidChannel(data) {
      return data.keys().hasAll(['id', 'serverId', 'name', 'type']) &&
             data.name is string && data.name.size() > 0 && data.name.size() < 100;
    }

    function isValidMessage(data) {
      return data.keys().hasAll(['id', 'channelId', 'authorId', 'content', 'timestamp']) &&
             data.content is string && data.content.size() > 0 && data.content.size() < 2000;
    }

    // Rules
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId) && isValidUser(request.resource.data);
    }

    match /servers/{serverId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidServer(request.resource.data);
      allow update, delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;

      match /channels/{channelId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && isValidChannel(request.resource.data);
        allow update, delete: if isAuthenticated() && get(/databases/$(database)/documents/servers/$(serverId)).data.ownerId == request.auth.uid;

        match /messages/{messageId} {
          allow read: if isAuthenticated();
          allow create: if isAuthenticated() && isValidMessage(request.resource.data) && request.resource.data.authorId == request.auth.uid;
          allow delete: if isAuthenticated() && (resource.data.authorId == request.auth.uid || get(/databases/$(database)/documents/servers/$(serverId)).data.ownerId == request.auth.uid);
        }
      }
    }
  }
}
